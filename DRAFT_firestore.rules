rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'deviceHardwareId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'deviceHardwareId', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.deviceHardwareId is string && data.deviceHardwareId.size() >= 1 && data.deviceHardwareId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: HealthReading
    function isValidHealthReading(data) {
      return data.keys().hasAll([
          'ownerId',
          'heartRate',
          'spo2',
          'hemoglobin',
          'perfusionIndex',
          'skinTemp',
          'deviceName',
          'connectionType',
          'status',
          'notes',
          'recordedAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'heartRate',
          'spo2',
          'hemoglobin',
          'perfusionIndex',
          'skinTemp',
          'deviceName',
          'connectionType',
          'status',
          'notes',
          'recordedAtMs',
          'createdAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.heartRate is number && data.heartRate >= 25 && data.heartRate <= 250 &&
        data.spo2 is number && data.spo2 >= 50 && data.spo2 <= 100 &&
        data.hemoglobin is number && data.hemoglobin >= 4 && data.hemoglobin <= 25 &&
        data.perfusionIndex is number && data.perfusionIndex >= 0.05 && data.perfusionIndex <= 25 &&
        data.skinTemp is number && data.skinTemp >= 25 && data.skinTemp <= 45 &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.connectionType is string && data.connectionType.size() >= 2 && data.connectionType.size() <= 10 &&
        (data.connectionType == 'BLE' || data.connectionType == 'WiFi') &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 20 &&
        (data.status == 'nominal' || data.status == 'warning' || data.status == 'critical') &&
        data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 500 &&
        data.recordedAtMs is number && data.recordedAtMs > 0 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: CameraCapture
    function isValidCameraCapture(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'captureMode',
          'resolution',
          'estimatedHb',
          'spo2AtCapture',
          'heartRateAtCapture',
          'imageDataUrl',
          'recordedAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'title',
          'captureMode',
          'resolution',
          'estimatedHb',
          'spo2AtCapture',
          'heartRateAtCapture',
          'imageDataUrl',
          'recordedAtMs',
          'createdAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.captureMode is string && data.captureMode.size() >= 1 && data.captureMode.size() <= 50 &&
        (data.captureMode == 'Sclera Hemoglobin Scan' || data.captureMode == 'Fingertip PPG Optical' || data.captureMode == 'MAX30102 Sensor Alignment') &&
        data.resolution is string && data.resolution.size() >= 1 && data.resolution.size() <= 32 &&
        data.estimatedHb is number && data.estimatedHb >= 4 && data.estimatedHb <= 25 &&
        data.spo2AtCapture is number && data.spo2AtCapture >= 50 && data.spo2AtCapture <= 100 &&
        data.heartRateAtCapture is number && data.heartRateAtCapture >= 25 && data.heartRateAtCapture <= 250 &&
        data.imageDataUrl is string && data.imageDataUrl.size() >= 5 && data.imageDataUrl.size() <= 350000 &&
        data.recordedAtMs is number && data.recordedAtMs > 0 &&
        data.createdAt is timestamp;
    }

    // Collection 1: /users/{userId} (PII Isolated to Owner Only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'deviceHardwareId', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }

    // Collection 2: /readings/{readingId}
    match /readings/{readingId} {
      allow get: if isSignedIn() && isValidId(readingId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(readingId) &&
        isValidHealthReading(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(readingId) &&
        isValidHealthReading(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        existing().status != 'critical' &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['notes'])
        );
      allow delete: if isVerifiedUser() && isValidId(readingId) && existing().ownerId == request.auth.uid;
    }

    // Collection 3: /captures/{captureId}
    match /captures/{captureId} {
      allow get: if isSignedIn() && isValidId(captureId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(captureId) &&
        isValidCameraCapture(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(captureId) &&
        isValidCameraCapture(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['title'])
        );
      allow delete: if isVerifiedUser() && isValidId(captureId) && existing().ownerId == request.auth.uid;
    }
  }
}
